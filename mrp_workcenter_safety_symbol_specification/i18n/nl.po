#. module: mrp_workcenter_safety_symbol_specification
#: model:ir.model.fields,help:mrp_workcenter_safety_symbol_specification.field_mrp_workcenter_safety_specification__specification_notes
msgid ""
"Add specific details, e.g., 'Type P2 required', 'Use chemical resistant "
"variant', 'Check before each use'."
msgstr ""
"Voeg specifieke details toe, bijv. 'Type P2 vereist', 'Gebruik chemisch "
"bestendige variant', 'Controleer voor elk gebruik'."

#. module: mrp_workcenter_safety_symbol_specification
#: model_terms:ir.ui.view,arch_db:mrp_workcenter_safety_symbol_specification.view_mrp_workcenter_safety_specification_list
msgid "Code"
msgstr "Code"

#. module: mrp_workcenter_safety_symbol_specification
#: model:ir.model.fields,help:mrp_workcenter_safety_symbol_specification.field_mrp_workcenter__safety_specification_ids
msgid ""
"Define safety symbols required for this work center and add specific "
"instructions."
msgstr ""
"Definieer de veiligheidssymbolen die vereist zijn voor deze werkplek en voeg"
" specifieke instructies toe."

#. module: mrp_workcenter_safety_symbol_specification
#: model:ir.model.constraint,message:mrp_workcenter_safety_symbol_specification.constraint_mrp_workcenter_safety_specification_workcenter_symbol_uniq
msgid "Each symbol can only be linked once per work center in specifications."
msgstr ""
"Elk symbool kan per werkplek slechts eenmaal aan een specificatie worden "
"gekoppeld."

#. module: mrp_workcenter_safety_symbol_specification
#: model_terms:ir.ui.view,arch_db:mrp_workcenter_safety_symbol_specification.view_mrp_workcenter_safety_specification_form
